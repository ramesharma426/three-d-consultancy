<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{company.name}} — {{company.tagline}}</title>
  <meta name="description" content="{{company.name}} provides house design (2D &amp; 3D CAD), architectural &amp; structural design, land surveys, and general engineering consultancy in {{company.location}}.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{company.siteUrl}}/">
  <meta name="theme-color" content="#0d0f0c">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{company.name}}">
  <meta property="og:title" content="{{company.name}} — {{company.tagline}}">
  <meta property="og:description" content="House design (2D &amp; 3D CAD), structural design, and land surveys for clients in {{company.location}}.">
  <meta property="og:url" content="{{company.siteUrl}}/">
  <meta property="og:image" content="{{company.siteUrl}}/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{company.name}} — {{company.tagline}}">
  <meta name="twitter:description" content="House design (2D &amp; 3D CAD), structural design, and land surveys for clients in {{company.location}}.">
  <meta name="twitter:image" content="{{company.siteUrl}}/images/og-image.png">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;700&family=Martian+Mono:wght@400;500&family=Noto+Sans+Devanagari:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{company.name}}",
    "description": "House design (2D & 3D CAD), architectural & structural design, land surveys, and general engineering consultancy.",
    "url": "{{company.siteUrl}}/",
    "image": "{{company.siteUrl}}/images/logo-full.png",
    "telephone": "{{company.phone}}",
    "email": "{{company.email}}",
    "sameAs": ["{{{company.facebookHref}}}"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{company.address}}",
      "addressLocality": "Hetauda",
      "addressRegion": "Bagmati Province",
      "addressCountry": "NP"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{company.mapCoordinates.lat}},
      "longitude": {{company.mapCoordinates.lng}}
    }
  }
  </script>
</head>
<body>
{{> sidebar}}
<main class="page">

  <section id="top" class="hero">
    <div class="container">
      <h1>
        <span data-i18n-en>{{company.tagline}}</span>
        <span data-i18n-ne hidden>{{company.taglineNe}}</span>
      </h1>
      <p class="hero-lead">
        <span data-i18n-en>House design, structural design, and land surveys — <em>dependable</em> engineering services for clients in Hetauda and across Nepal.</span>
        <span data-i18n-ne hidden>हेटौँडा र नेपालभरका ग्राहकहरूका लागि घर डिजाइन, संरचनात्मक डिजाइन, र जग्गा सर्वेक्षण — <em>भरपर्दो</em> इन्जिनियरिङ सेवा।</span>
      </p>
      <a class="btn btn-primary" href="#contact">
        <span data-i18n-en>Get in touch</span>
        <span data-i18n-ne hidden>सम्पर्क गर्नुहोस्</span>
      </a>
    </div>
  </section>

  <section id="about" class="page-section">
    <div class="container">
      <h2>
        <span data-i18n-en>About {{company.name}}</span>
        <span data-i18n-ne hidden>{{company.name}} बारे</span>
      </h2>
      <p data-reveal>
        <span data-i18n-en>{{company.name}} is an engineering consultancy based in {{company.location}}, providing house design (2D &amp; 3D CAD), structural design, land surveys, and general engineering consultancy to clients across Nepal.</span>
        <span data-i18n-ne hidden>{{company.name}} हेटौँडा, मकवानपुर जिल्ला, बागमती प्रदेश, नेपालमा आधारित एक इन्जिनियरिङ परामर्श कम्पनी हो, जसले नेपालभरका ग्राहकहरूलाई घर डिजाइन (2D र 3D CAD), संरचनात्मक डिजाइन, जग्गा सर्वेक्षण, र सामान्य इन्जिनियरिङ परामर्श सेवा प्रदान गर्दछ।</span>
      </p>

      <h3 class="sub-heading">
        <span data-i18n-en>Our Story</span>
        <span data-i18n-ne hidden>हाम्रो कथा</span>
      </h3>
      <p data-reveal>
        <span data-i18n-en><em>Placeholder — replace with the real company history.</em> {{company.name}} was founded to bring precise, dependable engineering and 3D design services to Hetauda and the surrounding region, combining technical rigor with a practical understanding of local projects.</span>
        <span data-i18n-ne hidden><em>प्लेसहोल्डर — वास्तविक कम्पनी इतिहासले प्रतिस्थापन गर्नुहोस्।</em> {{company.name}} हेटौँडा र वरपरका क्षेत्रहरूमा यथार्थ र भरपर्दो इन्जिनियरिङ तथा 3D डिजाइन सेवा पुर्‍याउन स्थापना गरिएको हो, जसले प्राविधिक कठोरतालाई स्थानीय परियोजनाहरूको व्यावहारिक बुझाइसँग जोड्दछ।</span>
      </p>

      <h3 class="sub-heading">
        <span data-i18n-en>What We Stand For</span>
        <span data-i18n-ne hidden>हाम्रा मूल्यहरू</span>
      </h3>
      <div class="grid-3" data-reveal-group>
        <div class="card" data-reveal>
          <h3>
            <span data-i18n-en>Precision</span>
            <span data-i18n-ne hidden>यथार्थता</span>
          </h3>
          <p>
            <span data-i18n-en>Every model and drawing is checked against real-world engineering requirements.</span>
            <span data-i18n-ne hidden>प्रत्येक मोडेल र नक्सा वास्तविक इन्जिनियरिङ आवश्यकताहरू अनुसार जाँच गरिन्छ।</span>
          </p>
        </div>
        <div class="card" data-reveal>
          <h3>
            <span data-i18n-en>Local Expertise</span>
            <span data-i18n-ne hidden>स्थानीय विशेषज्ञता</span>
          </h3>
          <p>
            <span data-i18n-en>Based in Hetauda, with first-hand knowledge of local sites, codes, and suppliers.</span>
            <span data-i18n-ne hidden>हेटौँडामा आधारित, स्थानीय साइट, नियम, र आपूर्तिकर्ताहरूको प्रत्यक्ष ज्ञानसहित।</span>
          </p>
        </div>
        <div class="card" data-reveal>
          <h3>
            <span data-i18n-en>Reliability</span>
            <span data-i18n-ne hidden>भरपर्दोपन</span>
          </h3>
          <p>
            <span data-i18n-en>Clear timelines, clear communication, and consistent delivery on every project.</span>
            <span data-i18n-ne hidden>स्पष्ट समयतालिका, स्पष्ट सञ्चार, र हरेक परियोजनामा निरन्तर डेलिभरी।</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="page-section page-section--tint">
    <div class="container">
      <h2>
        <span data-i18n-en>Our Services</span>
        <span data-i18n-ne hidden>हाम्रा सेवाहरू</span>
      </h2>
      <p>
        <span data-i18n-en>Engineering and design services tailored to your project, from first concept to construction-ready documentation.</span>
        <span data-i18n-ne hidden>पहिलो अवधारणादेखि निर्माणका लागि तयार कागजातसम्म, तपाईंको परियोजना अनुरूप इन्जिनियरिङ र डिजाइन सेवाहरू।</span>
      </p>

      <div class="service-detail" data-reveal>
        <h3>
          <span data-i18n-en>House Design — 2D &amp; 3D CAD</span>
          <span data-i18n-ne hidden>घर डिजाइन — 2D र 3D CAD</span>
        </h3>
        <p>
          <span data-i18n-en>Complete house design in both 2D CAD drawings and 3D models, from floor plans to photorealistic renders.</span>
          <span data-i18n-ne hidden>फ्लोर प्लानदेखि फोटोयथार्थ रेन्डरसम्म, 2D CAD नक्सा र 3D मोडेल दुवैमा पूर्ण घर डिजाइन।</span>
        </p>
        <ul>
          <li>
            <span data-i18n-en>2D CAD floor plans and elevations</span>
            <span data-i18n-ne hidden>2D CAD फ्लोर प्लान र एलिभेसन</span>
          </li>
          <li>
            <span data-i18n-en>3D architectural modeling and rendering</span>
            <span data-i18n-ne hidden>3D वास्तुकला मोडेलिङ र रेन्डरिङ</span>
          </li>
          <li>
            <span data-i18n-en>Design review and revisions</span>
            <span data-i18n-ne hidden>डिजाइन समीक्षा र संशोधन</span>
          </li>
          <li>
            <span data-i18n-en>Rendering for presentation and client review</span>
            <span data-i18n-ne hidden>प्रस्तुतीकरण र ग्राहक समीक्षाका लागि रेन्डरिङ</span>
          </li>
        </ul>
      </div>

      <div class="service-detail" data-reveal>
        <h3>
          <span data-i18n-en>Architectural &amp; Structural Design</span>
          <span data-i18n-ne hidden>वास्तुकला र संरचनात्मक डिजाइन</span>
        </h3>
        <p>
          <span data-i18n-en>Building design and structural engineering from concept through construction-ready plans.</span>
          <span data-i18n-ne hidden>अवधारणादेखि निर्माणका लागि तयार योजनासम्म भवन डिजाइन र संरचनात्मक इन्जिनियरिङ।</span>
        </p>
        <ul>
          <li>
            <span data-i18n-en>Architectural concept and layout design</span>
            <span data-i18n-ne hidden>वास्तुकला अवधारणा र लेआउट डिजाइन</span>
          </li>
          <li>
            <span data-i18n-en>Structural analysis and design</span>
            <span data-i18n-ne hidden>संरचनात्मक विश्लेषण र डिजाइन</span>
          </li>
          <li>
            <span data-i18n-en>Construction drawing sets</span>
            <span data-i18n-ne hidden>निर्माण नक्सा सेटहरू</span>
          </li>
          <li>
            <span data-i18n-en>Site assessment and coordination</span>
            <span data-i18n-ne hidden>साइट मूल्याङ्कन र समन्वय</span>
          </li>
        </ul>
      </div>

      <div class="service-detail" data-reveal>
        <h3>
          <span data-i18n-en>Land &amp; Site Survey</span>
          <span data-i18n-ne hidden>जग्गा तथा साइट सर्वेक्षण</span>
        </h3>
        <p>
          <span data-i18n-en>On-site land and site surveys to support accurate house design and construction planning.</span>
          <span data-i18n-ne hidden>सटीक घर डिजाइन र निर्माण योजनाका लागि प्रत्यक्ष जग्गा तथा साइट सर्वेक्षण।</span>
        </p>
        <ul>
          <li>
            <span data-i18n-en>Land and plot surveys</span>
            <span data-i18n-ne hidden>जग्गा तथा प्लट सर्वेक्षण</span>
          </li>
          <li>
            <span data-i18n-en>Site measurement and mapping</span>
            <span data-i18n-ne hidden>साइट मापन र म्यापिङ</span>
          </li>
          <li>
            <span data-i18n-en>Boundary and topographic survey</span>
            <span data-i18n-ne hidden>सिमाना तथा स्थलाकृतिक सर्वेक्षण</span>
          </li>
          <li>
            <span data-i18n-en>Survey documentation for design use</span>
            <span data-i18n-ne hidden>डिजाइन प्रयोजनका लागि सर्वेक्षण कागजात</span>
          </li>
        </ul>
      </div>

      <div class="service-detail" data-reveal>
        <h3>
          <span data-i18n-en>General Engineering Consultancy</span>
          <span data-i18n-ne hidden>सामान्य इन्जिनियरिङ परामर्श</span>
        </h3>
        <p>
          <span data-i18n-en>Independent technical advice across the life of a project.</span>
          <span data-i18n-ne hidden>परियोजनाको सम्पूर्ण अवधिभर स्वतन्त्र प्राविधिक सल्लाह।</span>
        </p>
        <ul>
          <li>
            <span data-i18n-en>Feasibility studies</span>
            <span data-i18n-ne hidden>सम्भाव्यता अध्ययन</span>
          </li>
          <li>
            <span data-i18n-en>Project technical advisory</span>
            <span data-i18n-ne hidden>परियोजना प्राविधिक सल्लाह</span>
          </li>
          <li>
            <span data-i18n-en>Quality and compliance review</span>
            <span data-i18n-ne hidden>गुणस्तर र अनुपालन समीक्षा</span>
          </li>
          <li>
            <span data-i18n-en>Engineering documentation support</span>
            <span data-i18n-ne hidden>इन्जिनियरिङ कागजात सहयोग</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section id="portfolio" class="page-section">
    <div class="container">
      <h2>
        <span data-i18n-en>Portfolio</span>
        <span data-i18n-ne hidden>पोर्टफोलियो</span>
      </h2>
      <div class="portfolio-feature">
        <h3>
          <span data-i18n-en>Sample Residential Structural Design</span>
          <span data-i18n-ne hidden>नमूना आवासीय संरचनात्मक डिजाइन</span>
        </h3>
        <p data-reveal>
          <span data-i18n-en>Structural design and drawings for a residential building project.</span>
          <span data-i18n-ne hidden>आवासीय भवन परियोजनाका लागि संरचनात्मक डिजाइन र नक्साहरू।</span>
        </p>
        <div class="portfolio-carousel" data-carousel data-lenis-prevent>
          <div class="carousel-track">
            {{#each portfolioPhotos}}
            <button
              type="button"
              class="carousel-card"
              data-lightbox-src="{{this.src}}"
              aria-label="View exterior photo {{this.n}} full size"
            ><img src="{{this.src}}" alt="" class="carousel-card-img" loading="lazy"></button>
            {{/each}}
          </div>
          <button type="button" class="carousel-nav carousel-nav--prev" aria-label="Previous photo">&larr;</button>
          <button type="button" class="carousel-nav carousel-nav--next" aria-label="Next photo">&rarr;</button>
        </div>
      </div>

    </div>
  </section>

  <section id="contact" class="page-section page-section--tint">
    <div class="container">
      <h2>
        <span data-i18n-en>Contact Us</span>
        <span data-i18n-ne hidden>सम्पर्क गर्नुहोस्</span>
      </h2>
      <p data-reveal>{{company.address}}</p>
      {{> contact-badges}}

      <div class="map-embed" data-reveal>
        <iframe
          title="{{company.name}} location"
          loading="lazy"
          src="https://www.google.com/maps?q={{company.mapCoordinates.lat}},{{company.mapCoordinates.lng}}&z=16&output=embed">
        </iframe>
        <div class="gmap-card">
          <div class="gmap-head">
            <div>
              <h3>{{company.name}}</h3>
              <p class="gmap-addr">{{company.address}}</p>
            </div>
            <div class="gmap-actions">
              <a href="https://www.google.com/maps?q={{company.mapCoordinates.lat}},{{company.mapCoordinates.lng}}" target="_blank" rel="noopener" title="View on Google Maps" aria-label="View on Google Maps">&#8599;</a>
              <a href="https://www.google.com/maps/dir/?api=1&destination={{company.mapCoordinates.lat}},{{company.mapCoordinates.lng}}" target="_blank" rel="noopener" title="Get directions" aria-label="Get directions">&#10148;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>
{{> footer}}
{{> float-contact}}
<script src="/js/vendor/lenis.min.js" defer></script>
<script src="/js/smooth-scroll.js" defer></script>
<script src="/js/scrollspy.js" defer></script>
<script src="/js/i18n.js" defer></script>
<script src="/js/carousel.js" defer></script>
<script src="/js/lightbox.js" defer></script>
<script src="/js/reveal.js" defer></script>
<script src="/js/micro-interactions.js" defer></script>
</body>
</html>
